# Names only. Never commit values (ADR-0007).
# Local: copy to .env.local and fill from `npx supabase status` (local stack only).
# Vercel: production values are set ONLY in the Production environment scope.

# Supabase (local / staging / production per environment)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public). Leave empty locally: CAPTCHA is disabled in the local stack.
# Staging: Cloudflare test key 1x00000000000000000000AA (always passes).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
